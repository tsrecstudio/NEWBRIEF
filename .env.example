# ============================================================================
# МСДИС Smart Brief — Конфигурация сервиса брифования клиентов
# Заказная разработка ПО для автоматизации бизнес- и производственных процессов
# ============================================================================

# Сетевые настройки контейнера (в контейнере всегда 0.0.0.0)
HOST=0.0.0.0
PORT=3000

# Публичный URL поддомена МСДИС (если пусто — определяется автоматически из заголовков запроса)
# Пример для продакшна: https://brief.mcdis.ru
PUBLIC_BASE_URL=

# ============================================================================
# Интеграция с CloseRouter API (https://closerouter.dev/)
# Выбрана флагманская модель максимального уровня рассуждений и архитектуры:
# anthropic/claude-opus-5.5 (с авто-резервом на openai/gpt-6.1-sol и claude-sonnet-5.5)
# ============================================================================
CLOSEROUTER_BASE_URL=https://api.closerouter.dev/v1
CLOSEROUTER_API_KEY=closerouter_your_api_key_here
CLOSEROUTER_MODEL=anthropic/claude-opus-5.5
CLOSEROUTER_FALLBACK_MODELS=openai/gpt-6.1-sol,anthropic/claude-sonnet-5.5,openai/gpt-6-astra

# Поиск информации о клиенте, отрасли и ИТ-ландшафте в сети Интернет
# Сервис встроенно ищет через DuckDuckGo + Wikipedia + прямой краулинг сайта клиента без доп. ключей.
# Опционально можно указать ключ Tavily Search API для расширенной выдачи.
AI_WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=

# ============================================================================
# Доступ администратора МСДИС (/admin) и защита сессий
# ============================================================================
ADMIN_LOGIN=admin
ADMIN_PASSWORD=mcdis-admin-2026
SESSION_SECRET=mcdis-brief-change-this-secret-in-production-2026

# ============================================================================
# Хранилище данных (SQLite + прикреплённые клиентами файлы)
# В Docker монтируется на постоянный volume /app/data
# ============================================================================
DATA_DIR=./data
MAX_UPLOAD_MB=25

# ============================================================================
# Фирменная палитра ООО «МСДИС» (по умолчанию цвета бренд-системы mcdis.ru;
# также можно загрузить корпоративный PDF брендбука прямо в /admin -> Бренд)
# ============================================================================
BRAND_PRIMARY=#306DFA
BRAND_SECONDARY=#486ACC
BRAND_NAVY=#082A5E
BRAND_DARK=#101013
BRAND_SURFACE=#F8F8F9
